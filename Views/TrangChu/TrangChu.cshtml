@model DashboardViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var currentUser = ViewBag.CurrentUser as UserAccount;
}

<section class="hero-panel hero-home">
    <div class="hero-content">
        <p class="eyebrow">Website quản lý trung tâm tiếng Anh</p>
        <h1>Quản lý khóa học, lớp học, giáo viên và học viên trong một hệ thống.</h1>
        <p class="hero-copy">Đồ án ASP.NET Core MVC kết nối SQL Server, có phân quyền Admin, Giáo viên và Học viên, đăng ký khóa học, thanh toán học phí và cập nhật hồ sơ.</p>
        @if (currentUser != null)
        {
            <p class="hero-welcome">Chào mừng bạn '@currentUser.FullName' đến với trang web của chúng tôi.</p>
        }
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="KhoaHoc" asp-action="DanhSach">Xem khóa học</a>
            @if (currentUser == null)
            {
                <a class="btn btn-outline-primary" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
            }
        </div>
    </div>
    @if (currentUser != null)
    {
        <div class="login-note hero-login">
            <strong>@currentUser.Role</strong>
            <span>@currentUser.Email</span>
            <span>@currentUser.Phone</span>
            <a class="btn btn-primary btn-sm mt-2" asp-controller="KhoaHoc" asp-action="DanhSach">Tiếp tục học tập</a>
        </div>
    }
</section>

<div class="section-title">
    <h2>Khóa học nổi bật</h2>
    <a asp-controller="KhoaHoc" asp-action="DanhSach">Xem tất cả</a>
</div>
<div class="course-grid">
    @foreach (var course in Model.FeaturedCourses)
    {
        <article class="course-card">
            <img class="course-card-image" src="@EnglishCenterStore.CourseImage(course)" alt="@course.Name" loading="lazy" />
            <div class="course-card-body">
                <span class="badge text-bg-light">@course.Level</span>
                <h3>@course.Name</h3>
                <p>@course.Description</p>
                <div class="course-meta">
                    <span>@course.Duration</span>
                    <strong>@course.Tuition.ToString("N0") VND</strong>
                </div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="KhoaHoc" asp-action="ChiTiet" asp-route-id="@course.Id">Chi tiết</a>
            </div>
        </article>
    }
</div>



