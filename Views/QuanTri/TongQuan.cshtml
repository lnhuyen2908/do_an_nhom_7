@model DashboardViewModel
@{
    var currentUser = ViewBag.CurrentUser as UserAccount;
    var isStaff = currentUser?.Role == "Staff";
    ViewData["Title"] = isStaff ? "Báo cáo và thống kê đào tạo" : "Dashboard quản trị";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@(isStaff ? "Nhân viên đào tạo" : "Admin")</p>
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="admin-tabs">
        @if (isStaff)
        {
            <a asp-action="HocVien">Học viên</a><a asp-action="LichKhaiGiang">Lớp học</a><a asp-action="DangKy">Đăng ký</a><a asp-action="HocPhi">Học phí</a>
        }
        else
        {
            <a asp-action="KhoaHoc">Khóa học</a><a asp-action="GiaoVien">Giáo viên</a><a asp-action="DangKy">Duyệt đăng ký</a><a asp-action="TaiKhoan">Tài khoản</a>
        }
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card"><span>Khóa học</span><strong>@Model.CourseCount</strong></div>
    <div class="stat-card"><span>Lớp học</span><strong>@Model.ClassCount</strong></div>
    <div class="stat-card"><span>Giáo viên</span><strong>@Model.TeacherCount</strong></div>
    <div class="stat-card"><span>Học viên</span><strong>@Model.StudentCount</strong></div>
    <div class="stat-card"><span>Chờ duyệt</span><strong>@Model.PendingEnrollmentCount</strong></div>
    <div class="stat-card"><span>Đã duyệt</span><strong>@Model.ApprovedEnrollmentCount</strong></div>
    <div class="stat-card"><span>Đã hủy</span><strong>@Model.CanceledEnrollmentCount</strong></div>
    <div class="stat-card"><span>Tổng học phí</span><strong>@Model.TotalTuition.ToString("N0")</strong><small>VND</small></div>
    <div class="stat-card"><span>Đã thu</span><strong>@Model.Revenue.ToString("N0")</strong><small>VND</small></div>
    <div class="stat-card"><span>Còn phải thu</span><strong>@Model.OutstandingTuition.ToString("N0")</strong><small>VND</small></div>
    <div class="stat-card"><span>Giao dịch</span><strong>@Model.PaymentTransactionCount</strong></div>
</div>

<div class="table-card">
    <h2>Số học viên theo lớp</h2>
    <table class="table align-middle">
        <thead><tr><th>Lớp</th><th>Khóa học</th><th>Số học viên</th></tr></thead>
        <tbody>
            @foreach (var item in Model.ClassStatistics)
            {
                <tr><td>@item.ClassCode</td><td>@item.CourseName</td><td>@item.StudentCount</td></tr>
            }
        </tbody>
    </table>
</div>



