@model List<CourseClass>
@{
    ViewData["Title"] = "Quản lý lịch khai giảng";
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var teachers = ViewBag.Teachers as List<Teacher> ?? new List<Teacher>();
    var currentUser = ViewBag.CurrentUser as UserAccount;
}
<div class="page-head"><div><p class="eyebrow">Quản trị đào tạo</p><h1>Quản lý lịch khai giảng</h1></div><div class="admin-tabs"><a asp-action="TongQuan">Tổng quan</a>@if (currentUser?.Role == "Admin") { <a asp-action="KhoaHoc">Khóa học</a><a asp-action="TaiKhoan">Tài khoản</a> }@if (currentUser?.Role == "Staff") { <a asp-action="HocVien">Học viên</a><a asp-action="DangKy">Đăng ký</a><a asp-action="HocPhi">Học phí</a> }</div></div>
<form class="form-card form-wide" asp-action="LuuLichKhaiGiang" method="post">@Html.AntiForgeryToken()<h2>Thêm lịch khai giảng</h2><div class="row g-2"><div class="col-md-2"><input class="form-control" name="Code" placeholder="LH04" pattern="LH[0-9]{2,}" title="Mã lớp học phải có dạng LH01" required /></div><div class="col-md-3"><select class="form-select" name="CourseId" required><option value="">Chọn khóa học</option>@foreach (var c in courses){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-md-3"><select class="form-select" name="TeacherId" required><option value="">Chọn giáo viên</option>@foreach (var t in teachers){<option value="@t.Id">@t.FullName</option>}</select></div><div class="col-md-2"><input class="form-control" name="Room" placeholder="Phòng" required /></div><div class="col-md-2"><input class="form-control" name="Capacity" type="number" min="1" max="500" value="20" required /></div><div class="col-md-3"><input class="form-control" name="StudyTime" placeholder="Thứ 2-4-6, 18:00" required /></div><div class="col-md-3"><input class="form-control" type="date" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><div class="col-md-2"><button class="btn btn-primary w-100">Thêm</button></div></div></form>
<div class="table-card"><table class="table"><thead><tr><th>Cập nhật lịch khai giảng</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var saveFormId = $"save-class-{item.Id}";
    var deleteFormId = $"delete-class-{item.Id}";
<tr><td><form id="@saveFormId" asp-action="LuuLichKhaiGiang" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Id" /></form><form id="@deleteFormId" asp-action="XoaLichKhaiGiang" method="post" data-confirm="Bạn có chắc chắn muốn xóa lịch khai giảng này không?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /></form><div class="row g-2 align-items-center"><div class="col-md-1"><input class="form-control form-control-sm" form="@saveFormId" name="Code" value="@item.Code" pattern="LH[0-9]{2,}" title="Mã lớp học phải có dạng LH01" required /></div><div class="col-md-2"><select class="form-select form-select-sm" form="@saveFormId" name="CourseId" required>@foreach (var c in courses){<option value="@c.Id" selected="@(c.Id == item.CourseId)">@c.Name</option>}</select></div><div class="col-md-2"><select class="form-select form-select-sm" form="@saveFormId" name="TeacherId" required>@foreach (var t in teachers){<option value="@t.Id" selected="@(t.Id == item.TeacherId)">@t.FullName</option>}</select></div><div class="col-md-1"><input class="form-control form-control-sm" form="@saveFormId" name="Room" value="@item.Room" required /></div><div class="col-md-2"><input class="form-control form-control-sm" form="@saveFormId" name="StudyTime" value="@item.StudyTime" required /></div><div class="col-md-2"><input class="form-control form-control-sm" form="@saveFormId" type="date" name="StartDate" value="@item.StartDate.ToString("yyyy-MM-dd")" required /></div><div class="col-md-1"><input class="form-control form-control-sm" form="@saveFormId" type="number" min="1" max="500" name="Capacity" value="@item.Capacity" required /></div><div class="col-md-1 d-flex gap-2"><button class="btn btn-sm btn-outline-primary" form="@saveFormId">Lưu</button><button class="btn btn-sm btn-outline-danger" form="@deleteFormId">Xóa</button></div></div></td></tr>
}
</tbody></table></div>



