@{
    var courseClass = ViewBag.Class as CourseClass;
    var course = ViewBag.Course as Course;
    var enrollments = ViewBag.Enrollments as List<Enrollment> ?? new List<Enrollment>();
    var students = ViewBag.Students as List<Student> ?? new List<Student>();
    var scores = ViewBag.Scores as List<Score> ?? new List<Score>();
    var attendance = ViewBag.Attendance as List<AttendanceRecord> ?? new List<AttendanceRecord>();
    ViewData["Title"] = "Quản lý lớp";
}
<div class="page-head"><div><p class="eyebrow">Giáo viên</p><h1>@courseClass?.Code - @course?.Name</h1><p>@courseClass?.StudyTime | @courseClass?.Room</p></div><a class="btn btn-outline-secondary" asp-action="LopHoc">Quay lại</a></div>
@if (!enrollments.Any())
{
    <div class="empty-state">
        <h2>Chưa có học viên trong lớp</h2>
        <p class="text-muted">Khi admin duyệt đăng ký và gán học viên vào lớp này, danh sách điểm danh và nhập điểm sẽ xuất hiện tại đây.</p>
    </div>
}
else
{
<div class="table-card"><h2>Danh sách học viên, điểm danh và nhập điểm</h2><table class="table align-middle"><thead><tr><th>Học viên</th><th>Điểm danh hôm nay</th><th>Giữa kỳ</th><th>Cuối kỳ</th><th>Nhận xét</th><th>Kết quả</th><th></th></tr></thead><tbody>
@foreach (var enrollment in enrollments)
{
    var student = students.FirstOrDefault(x => x.Id == enrollment.StudentId);
    var score = scores.FirstOrDefault(x => x.StudentId == enrollment.StudentId && x.ClassId == courseClass?.Id);
    var scoreFormId = $"score-form-{courseClass?.Id}-{enrollment.StudentId}";
    <tr>
        <td><strong>@student?.FullName</strong><br /><span class="text-muted">@student?.Code</span></td>
        <td>
            <form asp-action="LuuDiemDanh" method="post" class="attendance-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classId" value="@courseClass?.Id" />
                <input type="hidden" name="studentId" value="@enrollment.StudentId" />
                <input class="form-control form-control-sm" name="note" placeholder="Ghi chú" />
                <button class="btn btn-sm btn-outline-success" name="isPresent" value="true">Có mặt</button>
                <button class="btn btn-sm btn-outline-danger" name="isPresent" value="false">Vắng</button>
            </form>
            <small class="text-muted">@attendance.Count(x => x.StudentId == enrollment.StudentId) buổi đã ghi</small>
        </td>
        <td><input class="form-control form-control-sm" form="@scoreFormId" name="midterm" type="number" step="0.1" min="0" max="10" value="@(score?.Midterm ?? 0)" /></td>
        <td><input class="form-control form-control-sm" form="@scoreFormId" name="final" type="number" step="0.1" min="0" max="10" value="@(score?.Final ?? 0)" /></td>
        <td><input class="form-control form-control-sm" form="@scoreFormId" name="comment" value="@score?.Comment" /></td>
        <td>@(score?.Result ?? "-")</td>
        <td>
            <form id="@scoreFormId" asp-action="LuuDiem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classId" value="@courseClass?.Id" />
                <input type="hidden" name="studentId" value="@enrollment.StudentId" />
                <button class="btn btn-sm btn-primary">Lưu điểm</button>
            </form>
        </td>
    </tr>
}
</tbody></table></div>
}



