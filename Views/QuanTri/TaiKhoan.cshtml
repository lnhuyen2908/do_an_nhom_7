@model List<UserAccount>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}
<div class="page-head"><div><p class="eyebrow">Admin</p><h1>Quản lý tài khoản</h1></div><div class="admin-tabs"><a asp-action="TongQuan">Dashboard</a><a asp-action="KhoaHoc">Khóa học</a><a asp-action="GiaoVien">Giáo viên</a></div></div>
<form class="filter-bar" method="get">
    <input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm theo họ tên, username, vai trò, email, SĐT" />
    <button class="btn btn-primary">Tìm kiếm</button>
    <a class="btn btn-outline-secondary" asp-action="TaiKhoan">Tất cả</a>
</form>
<form class="form-card form-wide" asp-action="LuuTaiKhoan" method="post">
    @Html.AntiForgeryToken()
    <h2>Thêm tài khoản</h2>
    <div class="row g-2">
        <div class="col-md-2"><input class="form-control" name="FullName" placeholder="Họ tên" required /></div>
        <div class="col-md-2"><input class="form-control" name="UserName" placeholder="Username" minlength="3" required /></div>
        <div class="col-md-2"><input class="form-control" name="Password" type="password" placeholder="Mật khẩu" minlength="6" required /></div>
        <div class="col-md-2"><select class="form-select" name="Role"><option>Admin</option><option>Staff</option></select></div>
        <div class="col-md-2"><input class="form-control" name="Email" type="email" placeholder="Email" /></div>
        <div class="col-md-2"><input class="form-control" name="Phone" placeholder="SĐT" pattern="[0-9]{9,11}" title="Số điện thoại gồm 9 đến 11 chữ số" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Thêm</button></div>
    </div>
</form>
<div class="table-card"><table class="table align-middle"><thead><tr><th>Họ tên</th><th>Username</th><th>Mật khẩu mới</th><th>Vai trò</th><th>Email</th><th>SĐT</th><th></th></tr></thead><tbody>
@foreach (var item in Model)
{
    var userFormId = $"user-form-{item.Id}";
    <tr>
        <td><input class="form-control form-control-sm" form="@userFormId" name="FullName" value="@item.FullName" required /></td>
        <td><input class="form-control form-control-sm" form="@userFormId" name="UserName" value="@item.UserName" minlength="3" required /></td>
        <td><input class="form-control form-control-sm" form="@userFormId" name="Password" type="password" placeholder="Để trống nếu giữ nguyên" minlength="6" /></td>
        <td>
            @if (item.LinkedId > 0)
            {
                <input type="hidden" form="@userFormId" name="Role" value="@item.Role" />
                <span class="badge text-bg-light">@EnglishCenterStore.RoleText(item.Role)</span>
            }
            else
            {
                <select class="form-select form-select-sm" form="@userFormId" name="Role"><option selected="@(item.Role == "Admin")">Admin</option><option selected="@(item.Role == "Staff")">Staff</option></select>
            }
        </td>
        <td><input class="form-control form-control-sm" form="@userFormId" name="Email" type="email" value="@item.Email" /></td>
        <td><input class="form-control form-control-sm" form="@userFormId" name="Phone" value="@item.Phone" pattern="[0-9]{9,11}" title="Số điện thoại gồm 9 đến 11 chữ số" /></td>
        <td class="text-end">
            <form id="@userFormId" asp-action="LuuTaiKhoan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@item.Id" />
                <input type="hidden" name="LinkedId" value="@item.LinkedId" />
                <button class="btn btn-sm btn-outline-primary">Lưu</button>
            </form>
            <form asp-action="XoaTaiKhoan" method="post" class="d-inline" data-confirm="Bạn có chắc chắn muốn xóa không?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <button class="btn btn-sm btn-outline-danger">Xóa</button>
            </form>
        </td>
    </tr>
}
</tbody></table></div>



