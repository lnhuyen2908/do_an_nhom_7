@model IEnumerable<web_do_an1.Models.CourseClass>

@{
    ViewData["Title"] = "Danh sách";
    var currentPage = ViewBag.Page is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalItems = ViewBag.TotalItems is int total ? total : Model.Count();
}

<h1>Danh sách</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</p>
<form method="get" class="content-card filter-bar">
    <label>Tìm lớp/khóa/giáo viên<input class="form-control" name="keyword" value="@ViewBag.Keyword" /></label>
    <label>Ngày khai giảng<input class="form-control" type="date" name="startDate" value="@ViewBag.StartDate" /></label>
    <button class="btn btn-primary">Tìm kiếm</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Schedule)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                Trạng thái
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Course)
            </th>
            <th >
                @Html.DisplayNameFor(model => model.Teacher)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr><td colspan="9" class="empty-table-message">Không tìm thấy lớp học phù hợp.</td></tr>
}
else
{
foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Room)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Schedule)
            </td>
            <td>
                @item.StartDate.ToString("dd/MM/yyyy")
                @if (item.EndDate.HasValue)
                {
                    <small class="d-block text-muted">Đến @item.EndDate.Value.ToString("dd/MM/yyyy")</small>
                }
            </td>
            <td>
                <span class="status-pill status-class status-class-@(item.EffectiveStatus.ToString().ToLowerInvariant())">@DisplayStatus(item.EffectiveStatus)</span>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Capacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Course.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Teacher.FullName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
}
}
    </tbody>
</table>
@if (totalPages > 1)
{
    <nav class="pager-bar" aria-label="Phân trang lớp học">
        <span>Trang @currentPage/@totalPages · @totalItems lớp</span>
        <div>
            <a class="pager-number @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-startDate="@ViewBag.StartDate" asp-route-page="@(currentPage - 1)">&lt;</a>
            @foreach (var number in PaginationHelper.Build(currentPage, totalPages))
            {
                if (number == PaginationHelper.Ellipsis)
                {
                    <span class="pager-number disabled">...</span>
                }
                else
                {
                    <a class="pager-number @(number == currentPage ? "active" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-startDate="@ViewBag.StartDate" asp-route-page="@number">@number</a>
                }
            }
            <a class="pager-number @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-startDate="@ViewBag.StartDate" asp-route-page="@(currentPage + 1)">&gt;</a>
        </div>
    </nav>
}

@functions {
    private static string DisplayStatus(CourseClassStatus status) => status switch
    {
        CourseClassStatus.Upcoming => "Sắp khai giảng",
        CourseClassStatus.Open => "Đang mở",
        CourseClassStatus.Locked => "Đã khóa lớp",
        _ => "Đã đóng"
    };
}
