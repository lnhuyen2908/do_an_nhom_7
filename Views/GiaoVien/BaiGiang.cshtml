@model List<CourseLecture>
@{
    ViewData["Title"] = "Quản lý bài giảng";
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
}

<div class="page-head">
    <div><p class="eyebrow">Giáo viên</p><h1>Quản lý bài giảng</h1></div>
    <div class="admin-tabs"><a asp-action="LopHoc">Lớp của tôi</a><a asp-action="HoSo">Hồ sơ</a></div>
</div>

<form class="form-card form-wide" asp-action="TaiBaiGiang" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <h2>Thêm bài giảng</h2>
    @if (!courses.Any())
    {
        <p class="text-muted mb-0">Bạn chưa được phân công lớp học nên chưa thể đăng bài giảng.</p>
    }
    else
    {
        <div class="row g-2">
            <div class="col-md-3">
                <select class="form-select" name="courseId" required>
                    @foreach (var course in courses)
                    {
                        <option value="@course.Id">@course.Code - @course.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4"><input class="form-control" name="title" placeholder="Tiêu đề bài giảng" required /></div>
            <div class="col-md-3"><input class="form-control" name="file" type="file" accept=".pdf,.docx,.pptx" required /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100">Tải lên</button></div>
        </div>
    }
</form>

<div class="table-card">
    <h2>Danh sách bài giảng</h2>
    <table class="table align-middle">
        <thead><tr><th>Tiêu đề</th><th>Khóa học</th><th>File</th><th>Ngày đăng</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            var course = courses.FirstOrDefault(x => x.Id == item.CourseId);
            <tr>
                <td>@item.Title</td>
                <td>@course?.Name</td>
                <td><a asp-action="TaiXuongBaiGiang" asp-route-id="@item.Id">@item.FileName</a></td>
                <td>@item.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end">
                    <form asp-action="XoaBaiGiang" method="post" data-confirm="Xóa bài giảng này?">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
