@model IEnumerable<Course>
@{
    ViewData["Title"] = "Trang chủ";
    var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
    var roleDisplay = roleName switch
    {
        "Admin" => "Quản trị viên",
        "Staff" => "Nhân viên đào tạo",
        "Teacher" => "Giáo viên",
        "Student" => "Học viên",
        _ => string.Empty
    };
    var totalStudents = ViewBag.StudentCount is int studentCount ? studentCount : 0;
    var totalTeachers = ViewBag.TeacherCount is int teacherCount ? teacherCount : 0;
    var totalCourses = ViewBag.CourseCount is int courseCount ? courseCount : 0;
    var totalClasses = ViewBag.ClassCount is int classCount ? classCount : 0;
    var unreadNotifications = ViewBag.UnreadNotificationCount is int notificationCount ? notificationCount : 0;
}

<section class="hero-panel hero-home">
    <div class="hero-content">
        <p class="eyebrow">Trung tâm tiếng Anh hiện đại</p>
        <h1>Học tiếng Anh theo lộ trình rõ ràng, phù hợp với mục tiêu của bạn.</h1>
        <p class="hero-copy">
            Khám phá các khóa học giao tiếp, IELTS, TOEIC và tiếng Anh thiếu nhi cùng đội ngũ giáo viên đồng hành sát sao.
        </p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="hero-welcome">
                Chào mừng bạn '@User.Identity.Name' đến với trang web của chúng tôi.
            </p>
        }
        <div class="hero-actions">
            <a class="btn btn-primary" asp-controller="Courses" asp-action="Index">Xem khóa học</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
            }
        </div>
    </div>

    <aside class="hero-summary-card">
        <span class="hero-card-label">Tư vấn lộ trình</span>
        <strong>Chọn đúng khóa học ngay từ đầu</strong>
        <p>Giao tiếp, IELTS, TOEIC, thiếu nhi và lớp nền tảng theo mục tiêu học tập.</p>
        <div class="hero-mini-stats">
            <span><strong>@totalCourses</strong> khóa học</span>
            <span><strong>@totalClasses</strong> lớp học</span>
        </div>
        <a class="btn btn-sm btn-primary" asp-controller="Auth" asp-action="Register">Đăng ký tư vấn</a>
    </aside>
</section>

<section class="stats-grid home-count-grid" aria-label="Quy mô trung tâm">
    <article class="stat-card">
        <span>Học viên</span>
        <strong>@totalStudents</strong>
        <small>Đang theo học tại trung tâm</small>
    </article>
    <article class="stat-card">
        <span>Giáo viên</span>
        <strong>@totalTeachers</strong>
        <small>Đội ngũ giảng dạy</small>
    </article>
    <article class="stat-card">
        <span>Khóa học</span>
        <strong>@totalCourses</strong>
        <small>Chương trình đang cung cấp</small>
    </article>
    <article class="stat-card">
        <span>Lớp học</span>
        <strong>@totalClasses</strong>
        <small>Lịch khai giảng và các lớp hiện có</small>
    </article>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <article class="stat-card notification-stat-card">
            <span>Thông báo mới</span>
            <strong>@unreadNotifications</strong>
            <small><a asp-controller="Notifications" asp-action="Index">Xem thông báo</a></small>
        </article>
    }
</section>

<div class="section-title home-section-title">
    <div>
        <p class="section-kicker">Chương trình đào tạo</p>
        <h2>Khóa học nổi bật</h2>
    </div>
    <a class="btn btn-sm btn-outline-primary" asp-controller="Courses" asp-action="Index">Xem tất cả</a>
</div>

<div class="course-grid">
    @foreach (var course in Model)
    {
        <article class="course-card">
            <img class="course-card-image" src="@course.ImageUrl"
                 alt="@course.Name" loading="lazy" />
            <div class="course-card-body">
                <span class="badge text-bg-light">@course.Level</span>
                <h3>@course.Name</h3>
                <p>@course.Description</p>
                <div class="course-meta">
                    <span>@course.Duration</span>
                    <strong>@course.Tuition.ToString("N0") VND</strong>
                </div>
                <a class="btn btn-sm btn-outline-primary"
                   asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">
                    Chi tiết
                </a>
            </div>
        </article>
    }
</div>
