@model IEnumerable<UserAccount>
@{
    ViewData["Title"] = "Tài khoản";
    var currentPage = ViewBag.Page is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalItems = ViewBag.TotalItems is int total ? total : Model.Count();
}

<div class="page-head">
    <div>
        <p class="eyebrow">Hệ thống</p>
        <h1>Tài khoản người dùng</h1>
    </div>
    @* <a class="btn btn-primary" asp-action="Create">Tạo tài khoản</a> *@
</div>

<div class="table-card">
    <form method="get" class="filter-bar">
        <label>Tìm tài khoản<input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Tên đăng nhập, họ tên, email, số điện thoại" /></label>
        <button class="btn btn-primary">Tìm kiếm</button>
    </form>
    <table class="table">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Tên đăng nhập</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Liên kết</th> 
                <th>Hoạt động</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="empty-table-message">Không tìm thấy tài khoản phù hợp.</td></tr>
        }
        else
        {
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.UserName</td>
                <td>@item.Email</td>
                <td>@item.Role.DisplayName</td>
                <td>@(item.Student?.FullName ?? item.Teacher?.FullName ?? "—")</td> 
                <td>@(item.IsActive ? "Có" : "Không")</td>
                    <td class="text-nowrap action-links">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
        }
        }
        </tbody>
    </table>
</div>
@if (totalPages > 1)
{
    <nav class="pager-bar" aria-label="Phân trang tài khoản">
        <span>Trang @currentPage/@totalPages · @totalItems tài khoản</span>
        <div>
            <a class="pager-number @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-page="@(currentPage - 1)">&lt;</a>
            @foreach (var number in PaginationHelper.Build(currentPage, totalPages))
            {
                if (number == PaginationHelper.Ellipsis)
                {
                    <span class="pager-number disabled">...</span>
                }
                else
                {
                    <a class="pager-number @(number == currentPage ? "active" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-page="@number">@number</a>
                }
            }
            <a class="pager-number @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-page="@(currentPage + 1)">&gt;</a>
        </div>
    </nav>
}
