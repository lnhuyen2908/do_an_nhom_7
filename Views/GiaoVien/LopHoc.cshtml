@model List<CourseClass>
@{
    ViewData["Title"] = "Lớp của tôi";
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var enrollments = ViewBag.Enrollments as List<Enrollment> ?? new List<Enrollment>();
}
<div class="page-head"><div><p class="eyebrow">Giáo viên</p><h1>Lớp học của tôi</h1></div><div class="admin-tabs"><a asp-action="HoSo">Hồ sơ cá nhân</a></div></div>
<div class="course-grid">
@foreach (var item in Model)
{
    var course = courses.FirstOrDefault(x => x.Id == item.CourseId);
    <article class="course-card">
        @if (course != null)
        {
            <img class="course-card-image" src="@EnglishCenterStore.CourseImage(course)" alt="@course.Name" loading="lazy" />
        }
        <div class="course-card-body">
            <span class="badge text-bg-light">@item.Code</span>
            <h3>@course?.Name</h3>
            <p>@item.StudyTime - @item.Room</p>
            <div class="course-meta"><span>Bắt đầu @item.StartDate.ToString("dd/MM/yyyy")</span><strong>@enrollments.Count(x => x.ClassId == item.Id && x.Status == "DaDuyet") HV</strong></div>
            <a class="btn btn-outline-primary btn-sm" asp-action="ChiTietLop" asp-route-id="@item.Id">Quản lý lớp</a>
        </div>
    </article>
}
</div>



