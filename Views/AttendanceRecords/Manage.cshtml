@model IEnumerable<Enrollment>
@using web_do_an1.Models
@{
    ViewData["Title"] = "Điểm danh";
    var courseClass = (CourseClass)ViewBag.CourseClass;
    var studyDate = (DateTime)ViewBag.StudyDate;
    var attendance = ViewBag.Attendance as IEnumerable<AttendanceRecord> ?? [];
    var dateValidationMessage = ViewBag.DateValidationMessage as string;
}
<section class="page-heading"><div><p class="section-kicker">@courseClass.Code</p><h1>Điểm danh · @courseClass.Course.Name</h1><p>Ghi nhận tình trạng tham gia học theo từng ngày.</p></div><a class="btn btn-outline-secondary" asp-controller="CourseClasses" asp-action="MyClasses">Quay lại lớp dạy</a></section>
<section class="content-card">
    <form asp-action="Manage" method="get" class="filter-bar"><input type="hidden" name="classId" value="@courseClass.Id" /><label>Ngày học<input class="form-control" type="date" name="studyDate" value="@studyDate.ToString("yyyy-MM-dd")" /></label><button class="btn btn-outline-primary">Xem ngày</button></form>
    @if (!string.IsNullOrWhiteSpace(dateValidationMessage))
    {
        <div class="alert alert-danger">@dateValidationMessage</div>
    }
    <form asp-action="SaveAll" method="post">
        <input type="hidden" name="classId" value="@courseClass.Id" />
        <input type="hidden" name="studyDate" value="@studyDate.ToString("yyyy-MM-dd")" />
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Học viên</th><th style="min-width:520px">Tình trạng</th></tr></thead><tbody>
        @foreach (var enrollment in Model)
        {
            var record = attendance.FirstOrDefault(x => x.StudentId == enrollment.StudentId);
            <tr>
                <td><strong>@enrollment.Student.FullName</strong><small class="d-block text-muted">@enrollment.Student.Code</small></td>
                <td>
                    <div class="attendance-entry-form">
                        <input type="hidden" name="studentIds" value="@enrollment.StudentId" />
                        <div class="attendance-status-options">
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="isPresent_@enrollment.StudentId" value="true" checked="@(record?.IsPresent != false)" />
                                <span class="form-check-label">Có mặt</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="isPresent_@enrollment.StudentId" value="false" checked="@(record?.IsPresent == false)" />
                                <span class="form-check-label">Vắng</span>
                            </label>
                        </div>
                        <input class="form-control form-control-sm" name="note_@enrollment.StudentId" maxlength="500" placeholder="Ghi chú" value="@record?.Note" />
                    </div>
                </td>
            </tr>
        }
        </tbody></table></div>
        <div class="attendance-bulk-actions">
            <button class="btn btn-primary" type="submit" disabled="@(!string.IsNullOrWhiteSpace(dateValidationMessage))">Lưu tất cả</button>
        </div>
    </form>
</section>
