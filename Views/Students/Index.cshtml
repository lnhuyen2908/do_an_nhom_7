@model IEnumerable<web_do_an1.Models.Student>

@{
    ViewData["Title"] = "Danh sách";
    var currentPage = ViewBag.Page is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalItems = ViewBag.TotalItems is int total ? total : Model.Count();
}

<h1>Danh sách</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</p>
<form method="get" class="content-card filter-bar">
    <label>Tìm học viên<input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Mã, tên, email, số điện thoại" /></label>
    <button class="btn btn-primary">Tìm kiếm</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr><td colspan="7" class="empty-table-message">Không tìm thấy học viên phù hợp.</td></tr>
}
else
{
foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateOfBirth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
}
}
    </tbody>
</table>
@if (totalPages > 1)
{
    <nav class="pager-bar" aria-label="Phân trang học viên">
        <span>Trang @currentPage/@totalPages · @totalItems học viên</span>
        <div>
            <a class="pager-number @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-page="@(currentPage - 1)">&lt;</a>
            @foreach (var number in PaginationHelper.Build(currentPage, totalPages))
            {
                if (number == PaginationHelper.Ellipsis)
                {
                    <span class="pager-number disabled">...</span>
                }
                else
                {
                    <a class="pager-number @(number == currentPage ? "active" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-page="@number">@number</a>
                }
            }
            <a class="pager-number @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-page="@(currentPage + 1)">&gt;</a>
        </div>
    </nav>
}
