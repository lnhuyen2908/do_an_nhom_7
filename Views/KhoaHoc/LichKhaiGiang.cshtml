@model List<CourseClass>
@{
    ViewData["Title"] = "Lịch khai giảng";
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var teachers = ViewBag.Teachers as List<Teacher> ?? new List<Teacher>();
    var levels = ViewBag.Levels as List<string> ?? new List<string>();
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? Model.Count);
    var month = Model.Any() ? Model.Min(x => x.StartDate).Month : DateTime.Today.Month;
    var currentUser = ViewBag.CurrentUser as UserAccount;
    var isTeacherSchedule = (bool)(ViewBag.IsTeacherSchedule ?? false);
    var canManageSchedule = currentUser?.Role == "Admin" || currentUser?.Role == "Staff";
}

<section class="schedule-board">
    <div class="schedule-head">
        <div>
            <p class="eyebrow">Lịch khai giảng</p>
            <h1>@(isTeacherSchedule ? "Lịch khai giảng của tôi" : $"Tháng {month}")</h1>
            <span>@totalItems lớp đang mở</span>
        </div>
        @if (canManageSchedule)
        {
            <a class="btn btn-primary" asp-controller="QuanTri" asp-action="LichKhaiGiang">Thêm, sửa, xóa lịch</a>
        }
        else
        {
            <div class="schedule-sort">Ngày khai giảng gần nhất</div>
        }
    </div>

    <form class="schedule-filter" method="get">
        <input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Khóa học" />
        <select class="form-select" name="level">
            <option value="">Tất cả trình độ</option>
            @foreach (var item in levels)
            {
                <option value="@item" selected="@(ViewBag.Level == item)">@item</option>
            }
        </select>
        <select class="form-select" name="mode">
            <option value="">Tất cả hình thức</option>
            <option value="Offline" selected="@(ViewBag.Mode == "Offline")">Học tại lớp</option>
            <option value="Online" selected="@(ViewBag.Mode == "Online")">Học online</option>
        </select>
        <button class="btn btn-primary" type="submit">Lọc lịch</button>
    </form>

    <div class="schedule-table">
        <div class="schedule-row schedule-header">
            <span>Khóa học</span>
            <span>Khai giảng</span>
            <span>Buổi</span>
            <span>Ca học</span>
            <span>Địa điểm</span>
            <span>Hình thức</span>
            <span></span>
        </div>
        @foreach (var item in Model)
        {
            var course = courses.FirstOrDefault(x => x.Id == item.CourseId);
            var teacher = teachers.FirstOrDefault(x => x.Id == item.TeacherId);
            var isOnline = item.Room.Contains("Online", StringComparison.OrdinalIgnoreCase);
            var studyParts = item.StudyTime.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            var days = studyParts.FirstOrDefault() ?? item.StudyTime;
            var times = studyParts.Length > 1 ? studyParts.Skip(1) : new[] { item.StudyTime };
            <div class="schedule-row">
                <div>
                    <strong>@course?.Name</strong>
                    <small>@course?.Code - @course?.Level | GV: @teacher?.FullName</small>
                </div>
                <span>@item.StartDate.ToString("dd/MM/yyyy")</span>
                <span>@days</span>
                <span class="schedule-times">
                    @foreach (var time in times)
                    {
                        <span>@time</span>
                    }
                </span>
                <span>@item.Room</span>
                <span><mark class="mode-pill @(isOnline ? "online" : "offline")">@(isOnline ? "Học online" : "Học tại lớp")</mark></span>
                <div class="schedule-actions">
                    @if (canManageSchedule)
                    {
                        <a asp-controller="QuanTri" asp-action="LichKhaiGiang">Quản lý</a>
                    }
                    else if (isTeacherSchedule)
                    {
                        <a asp-controller="GiaoVien" asp-action="ChiTietLop" asp-route-id="@item.Id">Quản lý lớp</a>
                    }
                    else
                    {
                        <a asp-action="ChiTiet" asp-route-id="@item.CourseId">Đăng ký</a>
                        <a asp-action="ChiTiet" asp-route-id="@item.CourseId">Tư vấn</a>
                    }
                </div>
            </div>
        }
    </div>

    @if (totalItems > 12)
    {
        <nav class="pager-bar" aria-label="Phân trang lịch khai giảng">
            <span>Hiển thị @Model.Count trên tổng @totalItems lớp</span>
            <div>
                <a class="btn btn-outline-primary btn-sm @(page <= 1 ? "disabled" : "")"
                   asp-action="LichKhaiGiang"
                   asp-route-keyword="@ViewBag.Keyword"
                   asp-route-level="@ViewBag.Level"
                   asp-route-mode="@ViewBag.Mode"
                   asp-route-page="@(page - 1)">Trước</a>
                @for (var i = 1; i <= totalPages; i++)
                {
                    <a class="pager-number @(i == page ? "active" : "")"
                       asp-action="LichKhaiGiang"
                       asp-route-keyword="@ViewBag.Keyword"
                       asp-route-level="@ViewBag.Level"
                       asp-route-mode="@ViewBag.Mode"
                       asp-route-page="@i">@i</a>
                }
                <a class="btn btn-outline-primary btn-sm @(page >= totalPages ? "disabled" : "")"
                   asp-action="LichKhaiGiang"
                   asp-route-keyword="@ViewBag.Keyword"
                   asp-route-level="@ViewBag.Level"
                   asp-route-mode="@ViewBag.Mode"
                   asp-route-page="@(page + 1)">Sau</a>
            </div>
        </nav>
    }
</section>



