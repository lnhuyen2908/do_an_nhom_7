@model List<Student>
@{
    ViewData["Title"] = "Quản lý học viên";
    var enrollments = ViewBag.Enrollments as List<Enrollment> ?? new List<Enrollment>();
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? Model.Count);
}
<div class="page-head"><div><p class="eyebrow">Nhân viên đào tạo</p><h1>Quản lý học viên</h1></div><div class="admin-tabs"><a asp-action="TongQuan">Tổng quan</a><a asp-action="LichKhaiGiang">Lớp học</a><a asp-action="DangKy">Đăng ký</a><a asp-action="HocPhi">Học phí</a></div></div>
<form class="form-card form-wide" asp-action="LuuHocVien" method="post">@Html.AntiForgeryToken()<h2>Thêm học viên</h2><div class="row g-2"><div class="col-md-2"><input class="form-control" name="Code" placeholder="HV04" pattern="HV[0-9]{2,}" title="Mã học viên phải có dạng HV01" required /></div><div class="col-md-3"><input class="form-control" name="FullName" placeholder="Họ tên" required /></div><div class="col-md-2"><input class="form-control" type="date" name="DateOfBirth" max="@DateTime.Today.AddYears(-5).ToString("yyyy-MM-dd")" min="@DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd")" required /></div><div class="col-md-2"><input class="form-control" name="Phone" placeholder="Điện thoại" pattern="[0-9]{9,11}" title="Số điện thoại gồm 9 đến 11 chữ số" required /></div><div class="col-md-2"><input class="form-control" name="Email" type="email" placeholder="Email" required /></div><div class="col-md-1"><button class="btn btn-primary w-100">Thêm</button></div><div class="col-12"><input class="form-control" name="Address" placeholder="Địa chỉ" required /></div></div></form>
<div class="table-card"><table class="table"><thead><tr><th>Cập nhật học viên</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td><form class="row g-2 align-items-center" asp-action="LuuHocVien" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Id" /><div class="col-md-1"><input class="form-control form-control-sm" name="Code" value="@item.Code" pattern="HV[0-9]{2,}" title="Mã học viên phải có dạng HV01" required /></div><div class="col-md-2"><input class="form-control form-control-sm" name="FullName" value="@item.FullName" required /></div><div class="col-md-2"><input class="form-control form-control-sm" type="date" name="DateOfBirth" value="@item.DateOfBirth.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddYears(-5).ToString("yyyy-MM-dd")" min="@DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd")" required /></div><div class="col-md-2"><input class="form-control form-control-sm" name="Email" type="email" value="@item.Email" required /></div><div class="col-md-2"><input class="form-control form-control-sm" name="Phone" value="@item.Phone" pattern="[0-9]{9,11}" title="Số điện thoại gồm 9 đến 11 chữ số" required /></div><div class="col-md-2"><input class="form-control form-control-sm" name="Address" value="@item.Address" required /></div><div class="col-md-1"><button class="btn btn-sm btn-outline-primary">Lưu</button></div></form><div class="text-muted small mt-1">Đang học: @enrollments.Count(x => x.StudentId == item.Id && x.Status == "DaDuyet") khóa</div><form asp-action="XoaHocVien" method="post" class="mt-2" data-confirm="Bạn có chắc chắn muốn xóa học viên này không?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Xóa @item.Code</button></form></td></tr>
}
</tbody></table></div>
@if (totalItems > 12)
{
    <nav class="pager-bar" aria-label="Phân trang học viên">
        <span>Hiển thị @Model.Count trên tổng @totalItems học viên</span>
        <div>
            <a class="btn btn-outline-primary btn-sm @(page <= 1 ? "disabled" : "")" asp-action="HocVien" asp-route-page="@(page - 1)">Trước</a>
            @for (var i = 1; i <= totalPages; i++)
            {
                <a class="pager-number @(i == page ? "active" : "")" asp-action="HocVien" asp-route-page="@i">@i</a>
            }
            <a class="btn btn-outline-primary btn-sm @(page >= totalPages ? "disabled" : "")" asp-action="HocVien" asp-route-page="@(page + 1)">Sau</a>
        </div>
    </nav>
}



