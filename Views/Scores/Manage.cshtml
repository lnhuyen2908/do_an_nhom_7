@model IEnumerable<Enrollment>
@using web_do_an1.Models
@{
    ViewData["Title"] = "Nhập điểm";
    var courseClass = (CourseClass)ViewBag.CourseClass;
    var scores = ViewBag.Scores as IEnumerable<Score> ?? [];
}
<section class="page-heading"><div><p class="section-kicker">@courseClass.Code</p><h1>Điểm và nhận xét · @courseClass.Course.Name</h1><p>Nhập điểm giữa kỳ, cuối kỳ và nhận xét kết quả học tập.</p></div><a class="btn btn-outline-secondary" asp-controller="CourseClasses" asp-action="MyClasses">Quay lại lớp dạy</a></section>
<section class="content-card">
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Học viên</th><th style="min-width:520px">Kết quả học tập</th></tr></thead><tbody>
    @foreach (var enrollment in Model)
    {
        var score = scores.FirstOrDefault(x => x.StudentId == enrollment.StudentId);
        <tr>
            <td><strong>@enrollment.Student.FullName</strong><small class="d-block text-muted">@enrollment.Student.Code</small></td>
            <td>
                <form asp-action="Save" method="post" class="score-entry-form">
                    <input type="hidden" name="classId" value="@courseClass.Id" /><input type="hidden" name="studentId" value="@enrollment.StudentId" />
                    <label>Giữa kỳ<input class="form-control form-control-sm" type="text" name="midtermScore" inputmode="decimal" placeholder="0.00" oninput="filterDecimal(this)" onkeydown="insertDecimalAtCaret(event,this)" onblur="formatScore(this)" value="@(score?.MidtermScore.ToString("0.00") ?? "0")" /></label>
                    <label>Cuối kỳ<input class="form-control form-control-sm" type="text" name="finalScore" inputmode="decimal" placeholder="0.00" oninput="filterDecimal(this)" onkeydown="insertDecimalAtCaret(event,this)" onblur="formatScore(this)" value="@(score?.FinalScore.ToString("0.00") ?? "0")" /></label>
                    <label class="comment-field">Nhận xét<input class="form-control form-control-sm" name="comment" maxlength="500" value="@score?.Comment" /></label>
                    <button class="btn btn-sm btn-primary">Lưu</button>
                </form>
            </td>
        </tr>
    }
    </tbody></table></div>
</section>
