@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page auth-page-login">
    <div class="auth-visual" aria-hidden="true">
        <div class="auth-visual-content">
            <span class="auth-brand-mark">Trung tâm Tiếng Anh</span>
            <p>Chủ động học tập, theo dõi khóa học và quản lý trung tâm tại một nơi.</p>
        </div>
    </div>

    <div class="auth-form-panel">
        <form class="auth-form" asp-action="Login" method="post">
            <input name="returnUrl" value="@ViewBag.ReturnUrl" type="hidden" />
            <div class="auth-heading">
                <span class="eyebrow">Chào mừng trở lại</span>
                <h1>Đăng nhập</h1>
                <p>Nhập thông tin tài khoản để tiếp tục.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <div class="auth-field">
                <label class="form-label" for="login-user-name">Tên đăng nhập</label>
                <input class="form-control" id="login-user-name" name="userName"
                       value="@ViewBag.UserName" autocomplete="username"
                       placeholder="Ví dụ: admin, nvdt, gv01, st01" autofocus required />
            </div>

            <div class="auth-field">
                <label class="form-label" for="login-password">Mật khẩu</label>
                <input class="form-control" id="login-password" type="password" name="password"
                       autocomplete="current-password" placeholder="Nhập mật khẩu" required />
            </div>

            <div class="form-check mb-3">
                <input id="rememberMe" name="rememberMe" value="true"
                       type="checkbox" class="form-check-input" />
                <label for="rememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
            </div>

            <button class="btn btn-primary btn-auth-submit" type="submit">Đăng nhập</button>

            <div class="auth-switch">
                <span>Mật khẩu mặc định cho tất cả tài khoản:</span>
                <strong>123456</strong>
            </div>
        </form>
    </div>
</section>
