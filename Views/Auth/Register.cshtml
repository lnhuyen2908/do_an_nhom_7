@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<section class="auth-layout">
    <div class="auth-intro">
        <p class="section-kicker">Bắt đầu học ngay</p>
        <h1>Tạo tài khoản học viên</h1>
        <p>Khám phá khóa học, đăng ký lớp, theo dõi lịch học, điểm số và học phí trong một nơi.</p>
        <div class="auth-note">
            <strong>Mật khẩu mặc định</strong>
            <span>123456</span>
        </div>
    </div>
    <div class="auth-card">
        <h2>Thông tin đăng ký</h2>
        @if (ViewBag.Error is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        <form asp-action="Register" method="post" class="form-grid">
            <div class="form-field full"><label>Họ và tên</label><input class="form-control" name="fullName" value="@ViewBag.FullName" required /></div>
            <div class="form-field"><label>Tên đăng nhập</label><input class="form-control" name="userName" value="@ViewBag.UserName" minlength="3" required /></div>
            <div class="form-field"><label>Email</label><input class="form-control" type="email" name="email" value="@ViewBag.Email" required /></div>
            <div class="form-field"><label>Số điện thoại</label><input class="form-control" name="phone" value="@ViewBag.Phone" required /></div>
            <div class="form-field"><label>Ngày sinh</label><input class="form-control" type="date" name="dateOfBirth" value="@ViewBag.DateOfBirth" required /></div>
            <div class="form-field full"><label>Địa chỉ</label><input class="form-control" name="address" value="@ViewBag.Address" required /></div>
            <div class="full action-strip">
                <button class="btn btn-primary" type="submit">Tạo tài khoản</button>
                <a class="btn btn-outline-secondary" asp-action="Login">Đã có tài khoản</a>
            </div>
        </form>
    </div>
</section>
