@model IEnumerable<web_do_an1.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Danh sách";
    var currentPage = ViewBag.Page is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalItems = ViewBag.TotalItems is int total ? total : Model.Count();
}

<section class="page-heading"><div><p class="section-kicker">Đào tạo</p><h1>Lịch sử điểm danh</h1><p>Tổng hợp tình trạng tham gia học theo lớp và ngày học.</p></div></section>
<section class="content-card">
<form method="get" class="filter-bar">
    <label>Tìm điểm danh<input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Học viên, lớp, khóa học" /></label>
    <label>Ngày học<input class="form-control" type="date" name="studyDate" value="@ViewBag.StudyDate" /></label>
    <button class="btn btn-primary">Tìm kiếm</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Student)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseClass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StudyDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPresent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr><td colspan="5" class="empty-table-message">Không tìm thấy bản ghi điểm danh phù hợp.</td></tr>
}
else
{
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Student.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CourseClass.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StudyDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPresent)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
        </tr>
}
}
    </tbody>
</table>
@if (totalPages > 1)
{
    <nav class="pager-bar">
        <span>Trang @currentPage/@totalPages · @totalItems bản ghi</span>
        <div>
            <a class="pager-number @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-studyDate="@ViewBag.StudyDate" asp-route-page="@(currentPage - 1)">&lt;</a>
            @foreach (var number in PaginationHelper.Build(currentPage, totalPages))
            {
                if (number == PaginationHelper.Ellipsis)
                {
                    <span class="pager-number disabled">...</span>
                }
                else
                {
                    <a class="pager-number @(number == currentPage ? "active" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-studyDate="@ViewBag.StudyDate" asp-route-page="@number">@number</a>
                }
            }
            <a class="pager-number @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-studyDate="@ViewBag.StudyDate" asp-route-page="@(currentPage + 1)">&gt;</a>
        </div>
    </nav>
}
</section>
