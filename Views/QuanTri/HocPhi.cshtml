@model List<Payment>
@{
    ViewData["Title"] = "Quản lý học phí";
    var students = ViewBag.Students as List<Student> ?? new List<Student>();
    var enrollments = ViewBag.Enrollments as List<Enrollment> ?? new List<Enrollment>();
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var transactions = ViewBag.PaymentTransactions as List<PaymentTransaction> ?? new List<PaymentTransaction>();
}
<div class="page-head"><div><p class="eyebrow">Nhân viên đào tạo</p><h1>Quản lý học phí</h1></div><div class="admin-tabs"><a asp-action="TongQuan">Tổng quan</a><a asp-action="DangKy">Đăng ký</a><a asp-action="LichKhaiGiang">Lớp học</a><a asp-action="HocVien">Học viên</a></div></div>
<div class="table-card"><table class="table align-middle"><thead><tr><th>Học viên</th><th>Khóa học</th><th>Phải đóng</th><th>Đã đóng</th><th>Phương thức</th><th>Trạng thái</th><th>Ngày đóng</th><th></th></tr></thead><tbody>
@foreach (var item in Model)
{
    var student = students.FirstOrDefault(x => x.Id == item.StudentId);
    var enrollment = enrollments.FirstOrDefault(x => x.Id == item.EnrollmentId);
    var course = enrollment == null ? null : courses.FirstOrDefault(x => x.Id == enrollment.CourseId);
    <tr>
        <td>@student?.FullName</td>
        <td>@course?.Name</td>
        <td>@item.Amount.ToString("N0")</td>
        <td>
            <form class="payment-inline" asp-action="CapNhatHocPhi" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <input class="form-control form-control-sm" name="paidAmount" type="number" min="0" max="@item.Amount.ToString("0")" value="@item.PaidAmount.ToString("0")" />
                <select class="form-select form-select-sm" name="paymentMethod">
                    <option value="Cash" selected="@(item.PaymentMethod == "Cash")">Tiền mặt</option>
                    <option value="Transfer" selected="@(item.PaymentMethod == "Transfer")">Chuyển khoản</option>
                </select>
                <button class="btn btn-sm btn-primary">Lưu</button>
            </form>
        </td>
        <td>@EnglishCenterStore.PaymentMethodText(item.PaymentMethod)</td>
        <td><span class="badge text-bg-light">@EnglishCenterStore.StatusText(item.Status)</span></td>
        <td>@(item.PaidDate?.ToString("dd/MM/yyyy") ?? "-")</td>
        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="DangKy">Xem đăng ký</a></td>
    </tr>
}
</tbody></table></div>

<div class="table-card mt-4">
    <h2>Lịch sử ghi nhận học phí</h2>
    @if (!transactions.Any())
    {
        <p class="text-muted mb-0">Chưa có giao dịch thanh toán nào.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead><tr><th>Thời gian</th><th>Học viên</th><th>Khóa học</th><th>Biến động</th><th>Phương thức</th><th>Người ghi nhận</th><th>Nội dung</th></tr></thead>
            <tbody>
            @foreach (var transaction in transactions)
            {
                var payment = Model.FirstOrDefault(x => x.Id == transaction.PaymentId);
                var enrollment = payment == null ? null : enrollments.FirstOrDefault(x => x.Id == payment.EnrollmentId);
                var course = enrollment == null ? null : courses.FirstOrDefault(x => x.Id == enrollment.CourseId);
                var student = students.FirstOrDefault(x => x.Id == transaction.StudentId);
                <tr>
                    <td>@transaction.PaidAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@student?.FullName</td>
                    <td>@course?.Name</td>
                    <td class="@(transaction.Amount < 0 ? "text-danger" : "text-success")">@transaction.Amount.ToString("N0") VND</td>
                    <td>@EnglishCenterStore.PaymentMethodText(transaction.PaymentMethod)</td>
                    <td>@transaction.RecordedBy</td>
                    <td>@transaction.Note</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>



