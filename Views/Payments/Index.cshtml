@model IEnumerable<Payment>
@using web_do_an1.Models
@{
    ViewData["Title"] = "Quản lý học phí";
    var currentPage = ViewBag.Page is int page ? page : 1;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var totalItems = ViewBag.TotalItems is int total ? total : Model.Count();
}
<section class="page-heading"><div><p class="section-kicker">Tài chính</p><h1>Quản lý học phí</h1><p>Ghi nhận thanh toán và theo dõi công nợ của từng học viên.</p></div></section>
<section class="content-card">
    <form method="get" class="filter-bar">
        <label>Tìm học phí<input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Học viên, khóa học" /></label>
        <label>Trạng thái<select class="form-select" name="status"><option value="">Tất cả</option>@foreach (var state in Enum.GetValues<PaymentState>()){<option value="@state" selected="@(ViewBag.Status == state)">@state</option>}</select></label>
        <button class="btn btn-primary">Tìm kiếm</button>
    </form>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Học viên</th>
                    <th>Khóa học</th>
                    <th>Phải đóng</th>
                    <th>Đã đóng</th>
                    <th>Trạng thái</th>
     
                    <th style="min-width: 300px;">Cập nhật</th>
                </tr>

            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="empty-table-message">Không tìm thấy khoản học phí phù hợp.</td></tr>
            }
            else
            {
            @foreach (var item in Model)
            {
                var statusText = item.Status switch
                {
                    PaymentState.PendingApproval => "Chờ duyệt",
                    PaymentState.PartiallyPaid => "Đã đóng một phần",
                    PaymentState.Paid => "Thành công",
                    PaymentState.Cancelled => "Đã hủy",
                    _ => "Chưa thanh toán"
                };
                var statusCss = item.Status switch
                {
                    PaymentState.PendingApproval => "pending",
                    PaymentState.PartiallyPaid => "partial",
                    PaymentState.Paid => "paid",
                    _ => "unpaid"
                };
                <tr>
                    <td><strong>@item.Student.FullName</strong><small class="d-block text-muted">@item.Student.Code</small></td>
                    <td>@item.Enrollment.Course.Name<small class="d-block text-muted">@(item.Enrollment.CourseClass?.Code ?? "Chưa xếp lớp")</small></td>
                    <td>@item.Amount.ToString("N0") đ</td>
                    <td>@item.PaidAmount.ToString("N0") đ</td>
                    <td><span class="status-pill status-@statusCss">@statusText</span></td>
                    <td>
                        <form asp-action="RecordPayment" method="post" class="inline-management-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input class="form-control form-control-sm" type="number" min="0" max="@item.Amount.ToString("0")" step="1" name="paidAmount" value="@item.PaidAmount.ToString("0")" />
                            <select class="form-select form-select-sm" name="paymentMethod">
                                <option value="Cash" selected="@(item.PaymentMethod == PaymentMethod.Cash ? "selected" : null)">Tiền mặt</option>
                                <option value="BankTransfer" selected="@(item.PaymentMethod == PaymentMethod.BankTransfer ? "selected" : null)">Chuyển khoản</option>
                                <option value="Card" selected="@(item.PaymentMethod == PaymentMethod.Card ? "selected" : null)">Thẻ</option>
                            </select>
                            <button class="btn btn-sm btn-primary">Lưu</button>
                        </form>
                        @foreach (var transaction in item.PaymentTransactions
                            .Where(x => x.Status == PaymentTransactionState.Pending)
                            .OrderBy(x => x.PaidAt))
                        {
                            <div class="pending-payment-row">
                                <span>@transaction.PaidAt.ToString("dd/MM/yyyy HH:mm") · @transaction.Amount.ToString("N0") đ</span>
                                <form asp-action="ApproveTransaction" method="post">
                                    <input type="hidden" name="transactionId" value="@transaction.Id" />
                                    <button class="btn btn-sm btn-success">Duyệt</button>
                                </form>
                                <form asp-action="RejectTransaction" method="post">
                                    <input type="hidden" name="transactionId" value="@transaction.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Từ chối</button>
                                </form>
                            </div>
                        }
                        @if (item.Status == PaymentState.Paid)
                        {
                            <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="Reports" asp-action="InvoicePdf" asp-route-paymentId="@item.Id">Xuất hóa đơn</a>
                        }
                    </td>
                </tr>
            }
            }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <nav class="pager-bar">
            <span>Trang @currentPage/@totalPages · @totalItems khoản học phí</span>
            <div>
                <a class="pager-number @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status" asp-route-page="@(currentPage - 1)">&lt;</a>
                @foreach (var number in PaginationHelper.Build(currentPage, totalPages))
                {
                    if (number == PaginationHelper.Ellipsis)
                    {
                        <span class="pager-number disabled">...</span>
                    }
                    else
                    {
                        <a class="pager-number @(number == currentPage ? "active" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status" asp-route-page="@number">@number</a>
                    }
                }
                <a class="pager-number @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-keyword="@ViewBag.Keyword" asp-route-status="@ViewBag.Status" asp-route-page="@(currentPage + 1)">&gt;</a>
            </div>
        </nav>
    }
</section>
