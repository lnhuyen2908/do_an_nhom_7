<!DOCTYPE html>
<html lang="vi">
@{
    var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
    var roleDisplay = roleName switch
    {
        "Admin" => "Quản trị viên",
        "Staff" => "Nhân viên đào tạo",
        "Teacher" => "Giáo viên",
        "Student" => "Học viên",
        _ => string.Empty
    };
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trung tâm Tiếng Anh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="app-toast app-toast-success" data-app-toast role="status" aria-live="polite">
            <span>@message</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="app-toast app-toast-error" data-app-toast role="alert" aria-live="assertive">
            <span>@errorMessage</span>
        </div>
    }

    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom app-nav">
            <div class="container-fluid px-3 px-xl-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Trung tâm Tiếng Anh
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#main-navbar" aria-controls="main-navbar"
                        aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="main-navbar">
                    <ul class="navbar-nav me-auto align-items-xl-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courses" asp-action="Index">Khóa học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CourseClasses" asp-action="Schedule">Lịch khai giảng</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Dashboard">Tổng quan</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="admin-training-menu"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Quản lý đào tạo
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="admin-training-menu">
                                    <li><a class="dropdown-item" asp-controller="Courses" asp-action="Index">Khóa học</a></li>
                                    <li><a class="dropdown-item" asp-controller="CourseClasses" asp-action="Index">Lớp học và lịch khai giảng</a></li>
                                    <li><a class="dropdown-item" asp-controller="Enrollments" asp-action="Index">Xử lí đăng kí</a></li>
                                    <li><a class="dropdown-item" asp-controller="Scores" asp-action="Index">Kết quả học tập</a></li>
                                    <li><a class="dropdown-item" asp-controller="AttendanceRecords" asp-action="Index">Điểm danh</a></li>
                                    <li><a class="dropdown-item" asp-controller="CourseLectures" asp-action="Index">Bài giảng</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="admin-people-menu"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Nhân sự
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="admin-people-menu">
                                    <li><a class="dropdown-item" asp-controller="Students" asp-action="Index">Học viên</a></li>
                                    <li><a class="dropdown-item" asp-controller="Teachers" asp-action="Index">Giáo viên</a></li>
                                    <li><a class="dropdown-item" asp-controller="UserAccounts" asp-action="Index">Tài khoản</a></li>
                                    <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Vai trò</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="admin-finance-menu"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Tài chính
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="admin-finance-menu">
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">Quản lý học phí</a></li>
                                    <li><a class="dropdown-item" asp-controller="PaymentTransactions" asp-action="Index">Lịch sử giao dịch</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Dashboard">Thống kê vận hành</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="staff-training-menu"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Đào tạo
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="staff-training-menu">
                                    <li><a class="dropdown-item" asp-controller="Students" asp-action="Index">Quản lý học viên</a></li>
                                    <li><a class="dropdown-item" asp-controller="CourseClasses" asp-action="Index">Lớp học và lịch khai giảng</a></li>
                                    <li><a class="dropdown-item" asp-controller="Enrollments" asp-action="Index">Duyệt đăng ký</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index">Quản lý học phí</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CourseClasses" asp-action="MyClasses">Lớp giảng dạy</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="CourseLectures" asp-action="MyLectures">Bài giảng</a></li>
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="student-learning-menu" role="button" data-bs-toggle="dropdown">Học tập</a>
                                <ul class="dropdown-menu" aria-labelledby="student-learning-menu">
                                    <li><a class="dropdown-item" asp-controller="Enrollments" asp-action="MyEnrollments">Khóa học của tôi</a></li>
                                    <li><a class="dropdown-item" asp-controller="CourseClasses" asp-action="MySchedule">Lịch học</a></li>
                                    <li><a class="dropdown-item" asp-controller="Scores" asp-action="MyScores">Kết quả học tập</a></li>
                                    <li><a class="dropdown-item" asp-controller="CourseLectures" asp-action="LearningMaterials">Bài giảng</a></li>
                                    <li><a class="dropdown-item" asp-controller="SavedCourses" asp-action="MySavedCourses">Khóa học đã lưu</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="MyPayments">Học phí</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-xl-auto align-items-xl-center">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown account-menu">
                                <a class="nav-link dropdown-toggle account-menu-toggle" href="#"
                                   id="account-menu" role="button" data-bs-toggle="dropdown"
                                   data-bs-display="static" aria-expanded="false">
                                    <span>@User.Identity.Name</span>
                                    <small>@roleDisplay</small>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-menu">
                                    <li class="px-3 py-2">
                                        <small class="text-muted">Tài khoản đang đăng nhập</small>
                                        <strong class="d-block">@User.FindFirst("UserName")?.Value</strong>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (User.IsInRole("Student"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Students" asp-action="Profile">Hồ sơ cá nhân</a></li>
                                    }
                                    else if (User.IsInRole("Teacher"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Teachers" asp-action="Profile">Hồ sơ giảng viên</a></li>
                                    }
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            <button class="dropdown-item account-logout" type="submit">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <section class="dictionary-widget" data-dictionary-widget>
        <button class="dictionary-toggle" type="button" data-dictionary-toggle>Từ điển</button>
        <div class="dictionary-panel" data-dictionary-panel hidden>
            <div class="dictionary-head">
                <strong>Từ điển Anh - Việt</strong>
                <button type="button" aria-label="Đóng từ điển" data-dictionary-close>×</button>
            </div>
            <input class="form-control form-control-sm" data-dictionary-input
                   placeholder="Nhập từ tiếng Anh" autocomplete="off" />
            <div class="dictionary-result" data-dictionary-result>Nhập một từ để tra nhanh.</div>
        </div>
    </section>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
